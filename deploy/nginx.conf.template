# office-agent-mvp 生产反代配置（渲染到容器内 /etc/nginx/conf.d/default.conf）
# web 服务监听 80（对外 8080），静态资源直接返回，/api 反代到 api:8000。
#
# 注意：本文件以 .template 形式由 nginx 官方镜像的 envsubst 渲染，
# `${NGINX_CLIENT_MAX_BODY_SIZE}` 由 compose 的 MAX_UPLOAD_MB 联动注入。
# 其余 nginx 变量（$host 等）不受影响（NGINX_ENVSUBST_FILTER=NGINX_）。
#
# 片段 include 位置是 /etc/nginx/snippets/ 而非 conf.d/：
# conf.d/*.conf 会被顶层 nginx.conf 自动 include，把 location 级指令放进去会直接启动失败。

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # 上传体积上限（DOCX/PDF 素材）。
    # 与后端 MAX_UPLOAD_MB 联动：compose 会把同一个值注入这里（见 docker-compose.yml），
    # 改后端设置时同步改 MAX_UPLOAD_MB 即可，避免「后端允许 100MB 但 nginx 20MB 直接 413」。
    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    # 基础安全响应头（add_header 在子块出现时不会继承，故每个 location 都要 include）
    include /etc/nginx/snippets/security-headers.conf;

    # ===== SSE 长连接：必须关闭缓冲，读超时需覆盖审批等待（180s+）=====
    # 三条 SSE 路径正则统一匹配 /api 与 /api/v1 两套前缀
    # （后端同时挂载了 /api/v1 与旧 /api 别名，漏掉任一都会退化成缓冲 + 120s）。
    # 正则 location 必须写在兜底 location /api/ 之前，否则被兜底抢先命中。
    location ~ ^/api(/v1)?/(threads/[^/]+/events/stream|runs/[^/]+/events/stream|artifacts/[^/]+/regenerate)$ {
        include /etc/nginx/snippets/proxy-common.conf;
        include /etc/nginx/snippets/sse.conf;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # 其余 API：普通请求响应，默认缓冲 + 120s 读超时
    location /api/ {
        include /etc/nginx/snippets/proxy-common.conf;
        include /etc/nginx/snippets/security-headers.conf;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # SPA 路由：找不到静态文件就回 index.html
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }

    # 静态资源缓存
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
    }
}
