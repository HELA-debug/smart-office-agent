# EditorConfig：统一编辑器基础格式（所有新增文件 UTF-8 / LF）
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.{ts,tsx,js,jsx,json,jsonc,css,html,yml,yaml,md}]
indent_size = 2
max_line_length = 100

[Makefile]
indent_style = tab

[*.{md,yml,yaml}]
trim_trailing_whitespace = false
