# office-agent-mvp 环境变量模板（V2.1）
# 用法：cp .env.example .env   （.env 已被 .gitignore 忽略，禁止提交/打印/上传）
# 后端用 pydantic-settings 读取项目根 .env（变量名大小写不敏感）。
# 默认 MOCK_MODE=true：无 Key、断网也能完整演示。

# ---------- 应用 ----------
# dev | prod。prod 会关闭 /docs、/redoc 与 /openapi.json（契约快照见 contracts/）
APP_ENV=dev
# HOST/PORT 由 Dockerfile 的启动命令读取（uvicorn --host/--port），后端 Settings 不读取；
# 本地直接跑 uvicorn 时由命令行参数决定，改这里不生效。
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# 结构化日志：json（生产/CI，便于 trace_id/run_id 检索）| text（本地开发）
LOG_FORMAT=json

# ---------- 模型与路由（V2.1：多供应商，默认 DeepSeek）----------
# ENGINE=mock|real|deepagents（默认 real；无 Key/MOCK_MODE=true 时实际生效 mock）
ENGINE=real
# MOCK_MODE=true 时不调用任何外部模型；断网演示/CI 用
MOCK_MODE=true
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-chat
# fallback 顺序：依次尝试，失败自动降级；mock 永远兜底
MODEL_FALLBACK_CHAIN=deepseek,qwen,glm,mock
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_STEPS=60
MODEL_MAX_TOKENS=2000
# 采样温度与单次运行的 token 预算（防跑飞成本）
MODEL_TEMPERATURE=0.3
MODEL_TOKEN_BUDGET=200000
MOCK_MODEL_SPEED=0.05
# 允许模型 base_url 指向的域名白名单（逗号分隔；留空 = 只拦内网/本机地址段）
# 例：MODEL_BASE_URL_ALLOWLIST=api.deepseek.com,dashscope.aliyuncs.com
MODEL_BASE_URL_ALLOWLIST=

# ---- 供应商凭据：只写占位，真实值只放 .env，绝不提交 ----
# Key 的引用写法（设置中心/DB 只存引用，不存明文）：env:DEEPSEEK_API_KEY
# 也可以在「设置 → 添加 Key」里直接粘贴 Key：后端写入本机 .env 并立即生效。
MODEL_API_KEY_REF=env:DEEPSEEK_API_KEY

# DeepSeek（默认供应商，OpenAI 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 通义千问 DashScope（OpenAI 兼容模式）：DASHSCOPE_API_KEY 为常用名，
# 后端同时兼容 QWEN_API_KEY（两者任一即可）
DASHSCOPE_API_KEY=
QWEN_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 智谱 GLM（OpenAI 兼容）
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# OpenAI（可选，兼容保留）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# WorkBuddy（接口地址按账号给，没有公共默认值；两项都填才可用）
# 也可以在设置页「可用模型与 Key 状态」里点「填接口」「添加 Key」，不用改这里。
WORKBUDDY_API_KEY=
WORKBUDDY_BASE_URL=

# 兼容 V2.0 旧变量名（后端忽略；保留避免旧脚本报错）
MODEL_API_KEY=

# ---------- 存储 ----------
# SQLite（默认，零运维）或 PostgreSQL：postgresql://user:pass@host:5432/office_agent
DATABASE_URL=sqlite:///data/app.db
UPLOAD_DIR=./data/uploads
ARTIFACT_DIR=./data/artifacts

# ---------- 审批 ----------
# 命中这些工具名的高风险动作必须先审批（逗号分隔）
APPROVAL_RULES=doc.generate_report,file.delete,code.run_python
# 审批等待上限（秒），超时 → run.failed / APPROVAL_TIMEOUT
APPROVAL_TIMEOUT_SECONDS=180

# ---------- HTTP / 上传 ----------
# 本地开发时 Vite 通过代理转发 /api，一般无需改这里
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080
MAX_UPLOAD_MB=20
# 媒体素材（图片 / 录音 / 视频）单独一档上限：一段两小时的全员会远超 20MB
MAX_MEDIA_MB=200

# ---------- 图片识别 / 会议转写（可选依赖 backend[media] + backend[ocr-paddle]）----------
# 没装 media 扩展时这几项不起作用，health 的 media.ocr / media.asr 会报 false
# 用哪家识别引擎：
#   auto   —— 装了 PaddleOCR 就用它（更准），没装退回 RapidOCR（离线可用）。默认。
#   paddle —— 强制 PaddleOCR，缺组件时报错并给出安装命令（不会悄悄换一家）
#   rapid  —— 强制 RapidOCR
# PaddleOCR 需要额外装：pip install -e "backend[media,ocr-paddle]"
OCR_ENGINE=auto
# 识别语种：ch 中文（中英混排也走它）/ en 纯英文 / japan,korean 等
OCR_LANG=ch
# PP-OCR 模型代次（如 PP-OCRv5）。留空 = 用当前 PaddleOCR 的默认版本
OCR_VERSION=
# 整页方向分类（横向 / 倒置的扫描件）。要多下一个模型，默认关：
# 送识别前已按 EXIF 摆正，真躺倒的图由「转 90°/270° 重试」兜住
OCR_DOC_ORIENTATION=false
# 单行方向分类：表格里偶有倒着盖的章、竖排标注，开着更稳，代价很小
OCR_TEXTLINE_ORIENTATION=true
# 送识别前把最长边缩到这个值：手机原图 4000px 宽没有帮助，只会让检测多跑几倍时间
OCR_MAX_SIDE=2200
# 置信度下限：反光、遮挡处的乱码低于这个分数就不进正文（0~1）
OCR_MIN_SCORE=0.5
# oneDNN（CPU 加速）：能快一到两倍，但 Paddle 3.3 在部分 Windows CPU 上与 PIR
# 执行器冲突，一开就抛 ConvertPirAttribute2RuntimeAttribute，整张图认不出来。
# 默认关。确认自己机器跑得动再改成 true（真崩了也会自动关掉重试一次）
OCR_MKLDNN=false
# 转写模型：base（145MB，约 4 倍实时）/ small（460MB，更准）/ medium（1.5GB）
ASR_MODEL=base
# 语种：zh 时加「用简体、带标点」的前置提示并做繁转简；英文会议填 en；
# 填 auto 或留空 = 让模型自己判断（多语种会议用这个）
ASR_LANGUAGE=zh
# 模型下载源：直连 huggingface.co 在国内常 502，默认走镜像
ASR_ENDPOINT=https://hf-mirror.com
# 单段录音最多转写多少分钟（超出的部分截断并注明，防长录音烧穿预算）
ASR_MAX_MINUTES=60
# 自定义热词（逗号分隔）：永远排在 prompt 最前面，用来**兜底**。
# 人名和产品型号会自动从你已有的素材里学（见下面两项），这里只补程序学不到的：
# 少见姓的人、还没写进任何文档的客户代号。例：ASR_HOTWORDS=星环平台,华东大区
ASR_HOTWORDS=
# 从素材里自动认几个人名（「参会：张伟、李娜」和「[00:12] 张伟：」两种写法）。
# 0 = 关闭。宁可漏也不把「销售部」当人名，所以只认明确写法 + 常见姓氏。
ASR_PEOPLE=4
# 从素材里自动抽几个英数专名（产品名 / 型号 / 内部编号，如 DHT22、SSD1306）。
# 这类词一直在变，所以不写死在配置里，每次转写前从素材现取。0 = 关闭。
ASR_PROPER_NOUNS=6
# 除上面这些之外，再从素材里补多少个通用高频词（prompt 预算有限，十几个到顶）
ASR_HOTWORD_LIMIT=12
# 转写完再用大模型按上下文挑一遍同音字（只允许等长换词，不会改写内容）。
# 这一步会把转写文本发给当前配置的模型供应商；要全程离线就设成 false。
ASR_PROOFREAD=true
# 可选 API Token 兜底鉴权：留空 = 关闭（本地开发默认）。
# 配置后所有业务接口需带请求头 X-API-Token；健康检查与根路由始终免鉴权。
# 注意：配置界面/脚本调用时需带上该头。Docker 部署请同时把端口保持绑定回环。
API_TOKEN=
# 解析防护（压缩炸弹 / 超大文档）
MAX_UNCOMPRESSED_MB=256
MAX_ARCHIVE_ENTRIES=2000
MAX_PDF_PAGES=500
MAX_PARSED_CHARS=1000000

# ---------- 特性开关（逗号分隔 k=v；B2/B3 前端与后端共同读取）----------
FEATURE_FLAGS=real_model=true,settings_center=true,run_cancel=true,event_replay=true,artifact_library=true,skills=true

# ---------- 意见反馈（设置 → 关于 → 意见反馈）----------
# 用户写的内容会存到 ./data/feedback/feedback.jsonl（本机，不联网）；
# 同时按这个邮箱拼一条 mailto 链接，由用户自己的邮件程序发出——后端不直接发信。
# 留空 = 只存档，界面退化成「复制内容自己发」，等你填上开发者邮箱再启用。
FEEDBACK_EMAIL=

# ---------- 前端构建 ----------
VITE_API_BASE=/api

# ---------- 单端口运行（双击「启动 Office Agent」时由脚本自动打开）----------
# 打开后由后端直接托管 frontend/dist：只起一个进程、用户只访问 127.0.0.1:8000，
# 不需要 Node、不需要开两个终端。开发态保持 0（uvicorn + vite 双进程）。
SERVE_FRONTEND=0
# 前端构建产物目录，留空 = 仓库里的 frontend/dist
FRONTEND_DIST=
